[Unit]
Description=YouTube to Instagram Reels Telegram Bot
After=network.target

[Service]
Type=simple
User=azureuser
WorkingDirectory=/home/azureuser/Hellf
ExecStart=/home/azureuser/Hellf/venv/bin/python -m bot.main
Restart=always
RestartSec=5
EnvironmentFile=/home/azureuser/Hellf/.env
StandardOutput=append:/home/azureuser/Hellf/logs/systemd_stdout.log
StandardError=append:/home/azureuser/Hellf/logs/systemd_stderr.log

[Install]
WantedBy=multi-user.target
