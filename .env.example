# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Comma-separated list of numeric Telegram user IDs allowed to use the bot
ALLOWED_TELEGRAM_USER_IDS=123456789,987654321

# Instagram Graph API Configuration
INSTAGRAM_ACCESS_TOKEN=your_instagram_graph_api_long_lived_token_here
INSTAGRAM_BUSINESS_ACCOUNT_ID=your_instagram_business_account_id_here

# Azure Blob Storage Configuration
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=your_account;AccountKey=your_key;EndpointSuffix=core.windows.net
# Dedicated blob container for public video and cover hosting (defaults to ig-uploads)
AZURE_BLOB_CONTAINER=ig-uploads

# Logging Configuration (optional: DEBUG, INFO, WARNING, ERROR; defaults to INFO)
LOG_LEVEL=INFO

# =====================================================================
# Stage 2: YouTube yt-dlp Cloud IP Workaround Configuration
# =====================================================================
# Path to a Netscape-format cookies.txt file exported from a logged-in browser session.
# Azure datacenter IPs trigger YouTube bot detection; cookies bypass "Sign in to confirm you're not a bot".
# YTDLP_COOKIES_PATH=./cookies.txt

# Optional proxy URL (HTTP or SOCKS5) for residential or alternate routing fallback
# YTDLP_PROXY_URL=http://username:password@proxy.example.com:8080

# Ordered list of YouTube player clients to attempt in fallback sequence (defaults to android,ios,web)
# YTDLP_PLAYER_CLIENTS=android,ios,web

# =====================================================================
# Stage 4: Default Cover Image Configuration
# =====================================================================
# Path to the fixed default cover image (JPEG or PNG, 9:16 aspect ratio).
# If omitted, the bot searches for cover.png or cover.jpg in the project root.
# DEFAULT_COVER_PATH=./cover.jpg

# =====================================================================
# Stage 6: Instagram Publishing Configuration
# =====================================================================
# Optional signature, template, or hashtags appended to every Reel caption
# INSTAGRAM_CAPTION_SUFFIX=\n\nFollow @memoxz100k for daily memes! 🔥 #viral #reels
# Meta 24-hour rolling post rate limit (defaults to 50)
# INSTAGRAM_PUBLISH_RATE_LIMIT_24H=50

